rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated as an admin
    function isAdmin() {
      return request.auth != null;
    }

    // Menu Categories: Anyone can read, only admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu Items: Anyone can read, only admin can write
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Restaurant Settings: Anyone can read, only admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Users List: Only authenticated admins can read and write
    match /admin_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Orders: Anyone can create (place an order), only admin can view all, update status or delete
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
